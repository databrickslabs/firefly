flowchart TB
    subgraph Users["End Users"]
        U["👤 Users"]
    end

    subgraph IDP["Identity Provider"]
        direction TB
        OIDC["OAuth 2.0 / OIDC<br/>(Okta, Azure AD, Auth0)"]
    end

    subgraph FireFly["FireFly Analytics Platform"]
        direction TB
        FE["Next.js Frontend<br/>React + TanStack Query"]
        API["Next.js API Routes<br/>Server-side Middleware"]
        Auth["Better-Auth<br/>Session Management"]
        DB_PG[("PostgreSQL<br/>Sessions, Orgs, SPNs")]
    end

    subgraph Databricks["Databricks Lakehouse"]
        direction TB
        UC["Unity Catalog"]
        SQL["SQL Warehouse"]
        DBFS["DBFS / Volumes"]
        Apps["Databricks Apps"]
    end

    U --> FE
    U -.-> OIDC
    FE --> API
    API --> Auth
    Auth --> OIDC
    Auth --> DB_PG
    API --> UC
    API --> SQL
    API --> DBFS
    API --> Apps

    style FireFly fill:#fff7ed,stroke:#f97316
    style Databricks fill:#eff6ff,stroke:#3b82f6
    style IDP fill:#f0fdf4,stroke:#22c55e
    style FE fill:#f97316,stroke:#ea580c,color:#fff
    style API fill:#fb923c,stroke:#f97316,color:#fff
