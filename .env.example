# =============================================================================
# Databricks OAuth Configuration
# =============================================================================

# Databricks User-to-Machine (U2M) OAuth credentials
# Used for authenticating users via OAuth flow
DATABRICKS_U2M_CLIENT_ID=your_u2m_client_id_here
DATABRICKS_U2M_CLIENT_SECRET=your_u2m_client_secret_here

# Databricks Account ID
# Used to construct OIDC endpoints for Databricks workspaces
DATABRICKS_ACCOUNT_ID=your_account_id_here

# =============================================================================
# Database Configuration
# =============================================================================

# PostgreSQL database connection string (Neon or other PostgreSQL provider)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# =============================================================================
# Authentication & Security
# =============================================================================

# Better Auth secret for session encryption
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_here

# Better Auth URL (base URL for auth endpoints)
# Development: http://localhost:3000
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Encryption key for OAuth token storage (AES-256-GCM)
# Must be a 32-byte hex-encoded string (64 characters)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_character_hex_encoded_encryption_key_here

# Domain suffix for token encryption (optional, defaults to "com")
APP_DOMAIN_SUFFIX=com

# =============================================================================
# Proxy & Application Configuration
# =============================================================================

# Public URL for the Go proxy server
NEXT_PUBLIC_PROXY_URL=https://your-proxy-url.com

# Databricks code editor app URL
DATABRICKS_APP_URL=https://your-code-editor-app.databricksapps.com

# Databricks notebook editor app URL (Marimo)
DATABRICKS_NOTEBOOK_APP_URL=https://your-notebook-editor-app.databricksapps.com

# =============================================================================
# Agent Panel Configuration (managed-memory OpenAI agent)
# =============================================================================

# Toggle the slide-out Agent panel in the SSO-SPN org view.
# Set to "true" to show the panel; anything else hides it.
NEXT_PUBLIC_AGENT_ENABLED=false

# Deployed Databricks App URL for the managed-memory agent (Genie + memory).
# The Vercel-native reverse proxy at /api/agent-proxy forwards to this app,
# minting the current user's (or guest's) mapped SPN token as a bearer. No Go
# proxy / Cloud Run is required for the agent. Build/deploy the app from the
# vendor/app-templates submodule via scripts/assemble_agent.sh.
DATABRICKS_AGENT_APP_URL=https://your-agent-app.databricksapps.com

# =============================================================================
# Embedded Dashboard Configuration
# =============================================================================

# Databricks workspace instance URL for dashboard embedding
DATABRICKS_EMBED_INSTANCE_URL=https://your-workspace.cloud.databricks.com/

# Databricks workspace ID for dashboard embedding
DATABRICKS_EMBED_WORKSPACE_ID=your_workspace_id_here

# Dashboard ID to embed (from the Lakeview dashboard URL)
DATABRICKS_EMBED_DASHBOARD_ID=your_dashboard_id_here

# Databricks Machine-to-Machine (M2M) OAuth credentials for dashboard embedding
# Used for generating scoped tokens for embedded dashboards
DATABRICKS_M2M_CLIENT_ID=your_m2m_client_id_here
DATABRICKS_M2M_CLIENT_SECRET=your_m2m_client_secret_here

# =============================================================================
# SPN Auth Configuration (SSO to SPN Mapping)
# =============================================================================

# Databricks Account ID for SPN token generation
SPN_AUTH_DATABRICKS_ACCOUNT_ID=your_account_id_here

# Databricks Accounts Console URL (typically https://accounts.cloud.databricks.com)
SPN_AUTH_DATABRICKS_ACCOUNTS_URL=https://accounts.cloud.databricks.com

# Databricks Workspace URL for SPN tokens
SPN_AUTH_DATABRICKS_WORKSPACE_URL=https://your-workspace.cloud.databricks.com

# Okta OAuth Configuration for SPN Auth
SPN_AUTH_OKTA_CLIENT_ID=your_okta_client_id
SPN_AUTH_OKTA_CLIENT_SECRET=your_okta_client_secret
SPN_AUTH_OKTA_ISSUER=https://your-tenant.okta.com/oauth2/default

# =============================================================================
# BYOD (Bring Your Own Data) Configuration
# =============================================================================

# Global Admin SPN credentials for BYOD provider/share lookups
# These are used to query Delta Sharing providers and shares on behalf of the organization
FIREFLY_SPN_GLOBAL_ADMIN_CLIENT_ID=your_global_admin_client_id
FIREFLY_SPN_GLOBAL_ADMIN_CLIENT_SECRET=your_global_admin_client_secret

# Secret scope name for storing user SPN secrets in workspaces
# This scope will be created (if not exists) and used to store user SPN credentials
FIREFLY_WORKSPACE_SPN_SECRET_SCOPE_NAME=firefly-workspace-spn-secrets

# =============================================================================
# Guest User API Configuration
# =============================================================================

# Secret API key for guest user management endpoints (64-character hex string)
# Generate with: openssl rand -hex 64
GUEST_API_SECRET=your_64_character_hex_guest_api_secret_here

# =============================================================================
# Optional Configuration
# =============================================================================

# OAuth cleanup endpoint secret (optional, defaults to "cleanup-secret")
OAUTH_CLEANUP_SECRET=cleanup-secret

# Custom build output directory (optional, defaults to ".next")
# BUILD_DIR=.next

# Enable token debugging (optional, set to 'true' to enable)
# DEBUG_TOKENS=false

# Node environment (optional, automatically set by Node.js)
# NODE_ENV=development

